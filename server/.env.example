# Port the Socket.IO server listens on
PORT=3001

# Must match the origin the Next.js app is actually served from, or the
# browser will block the WebSocket handshake as a CORS violation.
# Same-machine dev: http://localhost:3000
# LAN testing from another device: http://<this-machine's-LAN-IP>:3000
CLIENT_ORIGIN=http://localhost:3000
