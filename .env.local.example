# Socket.IO server URL - runs as a separate Node process alongside Next.js
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public base URL for the Next.js app itself
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for signing auth session cookies. Use a long random value in production.
AUTH_SECRET=change-me-in-local-dev

# Firebase client config from Project settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Firebase service account values from Project settings > Service accounts.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Optional: set to json only for legacy local tests/migration scripts.
# LINGO_AUTH_STORE=json
# LINGO_DATA_DIR=./data

# Mapbox public token - get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiLi4uIn0.
