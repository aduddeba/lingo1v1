# Socket.IO server URL - runs as a separate Node process alongside Next.js
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public base URL for the Next.js app itself
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for signing auth session cookies. Use a long random value in production.
AUTH_SECRET=change-me-in-local-dev

# Optional directory for persistent JSON user storage. Defaults to ./data.
LINGO_DATA_DIR=./data

# Mapbox public token - get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiLi4uIn0.
